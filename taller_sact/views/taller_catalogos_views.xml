<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taller_tipo_equipo_list" model="ir.ui.view">
        <field name="name">taller.tipo.equipo.list</field>
        <field name="model">taller.tipo.equipo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_taller_tipo_equipo_form" model="ir.ui.view">
        <field name="name">taller.tipo.equipo.form</field>
        <field name="model">taller.tipo.equipo</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name"/>
                    <field name="active"/>
                    <field name="sact_id" readonly="1"/>
                    <field name="marca_ids" readonly="1"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_taller_tipo_equipo" model="ir.actions.act_window">
        <field name="name">Tipos de equipo</field>
        <field name="res_model">taller.tipo.equipo</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_taller_marca_list" model="ir.ui.view">
