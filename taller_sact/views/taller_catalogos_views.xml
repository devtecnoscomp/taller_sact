            <tree>
                <field name="name"/>
                <field name="tipo_equipo_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_taller_marca_form" model="ir.ui.view">
        <field name="name">taller.marca.form</field>
        <field name="model">taller.marca</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group>
                    <field name="name"/>
                    <field name="tipo_equipo_id"/>
                    <field name="active"/>
                    <field name="sact_id" readonly="1"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_taller_marca" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">taller.marca</field>
        <field name="view_mode">list,form</field>
    </record>

