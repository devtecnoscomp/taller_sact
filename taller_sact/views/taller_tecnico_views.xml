<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_taller_tecnico_list" model="ir.ui.view">
        <field name="name">taller.tecnico.list</field>
        <field name="model">taller.tecnico</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="telefono"/>
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_taller_tecnico_form" model="ir.ui.view">
        <field name="name">taller.tecnico.form</field>
        <field name="model">taller.tecnico</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="telefono"/>
                        <field name="user_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_taller_tecnico" model="ir.actions.act_window">
        <field name="name">Técnicos</field>
        <field name="res_model">taller.tecnico</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
